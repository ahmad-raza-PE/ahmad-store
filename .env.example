# Copy this file to ".env" (or set the same names as environment variables on your host). Never commit the real file.

# ---- Required ----
# Your public website address, exactly as customers type it. Use https:// in production.
BASE_URL=https://www.yourdomain.com
PORT=3000

# Where the database and the PRIVATE paid files live. Must be a persistent disk/volume, outside the web folder.
DATA_DIR=./data

# Set to 1 when the site runs behind a proxy / platform load balancer (Render, Railway, Caddy, Nginx...)
TRUST_PROXY=0

# ---- First administrator (used once, on first start, only if no admin exists) ----
# 12+ characters. After the first start, DELETE ADMIN_PASSWORD from the environment.
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=

# ---- Card payments: Stripe ----
# Start with TEST keys (sk_test_...). Switch to live keys only after a successful test purchase.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...) created for BASE_URL/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ---- Email for receipts and password resets (optional but recommended) ----
SMTP_HOST=
SMTP_PORT=465
# tls = port 465, starttls = port 587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ahmad Raza <orders@yourdomain.com>"

# ---- Optional tuning ----
MAX_UPLOAD_MB=500
DOWNLOAD_LIMIT=5
# 0 = purchased downloads never expire
DOWNLOAD_EXPIRY_DAYS=0
TZ_OFFSET_HOURS=4
